[Unit]
Description=Sonarqube 26
After=network.target network-online.target
Wants=network-online.target

[Service]
ExecStart=/home/sonarqube/sonarqube-26.2.0.119303/bin/linux-x86-64/sonar.sh start
ExecStop=/home/sonarqube/sonarqube-26.2.0.119303/bin/linux-x86-64/sonar.sh stop
ExecReload=/home/sonarqube/sonarqube-26.2.0.119303/bin/linux-x86-64/sonar.sh restart
Environment="JAVA_HOME={{ temurin_java_home }}"
Environment="SONAR_JAVA_PATH={{ temurin_java_home }}/bin/java"
Environment="PATH={{ temurin_java_home }}/bin:/usr/bin:/bin"
Type=forking
User=sonarqube
Group=sonarqube


LimitNOFILE=65536
LimitNPROC=8192
Restart=always

[Install]
WantedBy=multi-user.target